# Salin menjadi ".env" (satu folder dengan main.py / LibraryKiosk.exe)

# Alamat backend Laravel (gunakan HTTPS)
KIOSK_API_URL=https://server-lab.kampus.ac.id
# Token unik PC ini, hasil:  php artisan kiosk:register PC-01 AA:BB:CC:DD:EE:01
KIOSK_TOKEN=

CAMERA_INDEX=0

# Hash SHA-256 PIN admin (keluar kiosk: Ctrl+Shift+F12)
#   python -c "import hashlib;print(hashlib.sha256(b'PIN_ANDA').hexdigest())"
ADMIN_PIN_SHA256=
